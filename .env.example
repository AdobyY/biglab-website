# Required production settings
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=example.org,www.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.org,https://www.example.org
WAGTAILADMIN_BASE_URL=https://example.org

# Persist both paths outside the disposable application container.
SQLITE_PATH=/data/db.sqlite3
MEDIA_ROOT=/data/media

# Automatic content synchronization is disabled by default, including the Docker image.
# Set to 1 only to intentionally import new snapshots; this can overwrite CMS edits.
# Normal content import is manual: python manage.py seed_biglab
# Manual full content reset: python manage.py seed_biglab --reset
SEED_INITIAL_CONTENT=0

# HTTPS security. Increase HSTS only after HTTPS is confirmed to work.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false

# Optional email settings for password-reset messages.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

# Sentry error monitoring. Empty DSN disables it; build settings never initialize it.
# Use the project's Client Keys (DSN) value, not an API/authentication token.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Defaults to 0.1 in production and 1.0 in local development.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional. Railway's RAILWAY_GIT_COMMIT_SHA is used automatically when unset.
SENTRY_RELEASE=
