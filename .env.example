# Required production settings
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=example.org,www.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.org,https://www.example.org
WAGTAILADMIN_BASE_URL=https://example.org

# Persist both paths outside the disposable application container.
SQLITE_PATH=/data/db.sqlite3
MEDIA_ROOT=/data/media

# Set to 1 for the first deployment. The seeder is idempotent, but this can be
# set back to 0 after the initial content has been created.
SEED_INITIAL_CONTENT=1

# HTTPS security. Increase HSTS only after HTTPS is confirmed to work.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false

# Optional email settings for password-reset messages.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
