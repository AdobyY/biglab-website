[Unit]
Description=Back up BIG Lab SQLite and media during a short maintenance window
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/biglab
EnvironmentFile=/etc/biglab-deploy.env
ExecStart=/usr/bin/docker compose stop app
ExecStart=/usr/bin/docker compose run --rm --no-deps app python manage.py backup_site --output-dir /backups
# Restart even when archive creation fails. Monitor failures with systemctl/journalctl.
ExecStopPost=/usr/bin/docker compose start app
TimeoutStartSec=30min
